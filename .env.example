ANTHROPIC_API_KEY=sk-ant-...
# Optional: pin a model instead of auto-selecting the newest Sonnet
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Account sync (deploy.sh sets these up on Vercel; for local dev run `vercel env pull`)
BLOB_READ_WRITE_TOKEN=
# Any random string of 32+ characters, e.g. `openssl rand -base64 48`
AUTH_SECRET=
